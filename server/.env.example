# Copy to .env and adjust. All values below are safe local defaults.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/speednet_arena
JWT_SECRET=change-me-to-a-long-random-string

# Optional — enables the AI-assisted grading second-opinion pass AND the
# teacher's "Generate questions from PDF" feature. Without it, free-text grading
# is exact-match only and PDF generation is disabled; nothing else changes.
ANTHROPIC_API_KEY=
# Optional override; defaults to a small/fast model for the grading task.
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional override for PDF->questions generation (a stronger model than the
# grading default). Defaults to claude-sonnet-5.
ANTHROPIC_GEN_MODEL=claude-sonnet-5
